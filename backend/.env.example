# LLM Providers
GROQ_API_KEY=
GEMINI_API_KEY=

# Model Priority
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_FAST_FALLBACK_MODEL=llama-3.1-8b-instant
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Transcription
DEEPGRAM_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Redis / Durable Queues
REDIS_URL=
INTENT_STREAM_NAME=fh:intent:stream
INTENT_CONSUMER_GROUP=fh:intent-workers
INTENT_QUEUE_MAXLEN=10000
INTENT_QUEUE_LOCAL_MAXSIZE=100
INTENT_PENDING_IDLE_MS=60000
INTENT_PROCESSING_LOCK_SECONDS=300
REPORT_STREAM_NAME=fh:report:stream
REPORT_CONSUMER_GROUP=fh:report-workers
REPORT_QUEUE_MAXLEN=5000
REPORT_QUEUE_LOCAL_MAXSIZE=50
REPORT_PENDING_IDLE_MS=120000
REPORT_PROCESSING_LOCK_SECONDS=900
INTENT_QUEUE_ALERT_PENDING=100
INTENT_QUEUE_ALERT_FAILED=10
REPORT_QUEUE_ALERT_PENDING=25
REPORT_QUEUE_ALERT_FAILED=5
RUN_EMBEDDED_WORKERS=true

# LiveKit Server
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# API Protection
MAX_REQUEST_BYTES=524288
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60
